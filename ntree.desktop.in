[Desktop Entry]
Type=Application
Version=1.0
Name=ntree
GenericName=FLAC Library Quality Browser
Comment=Browse a FLAC library and detect lossy-source files via spectral analysis (ndisc suite)
Exec=@BINDIR@/ntree
Icon=@ICONDIR@/ntree.svg
Terminal=false
Categories=AudioVideo;Audio;Utility;
Keywords=flac;audio;lossless;lossy;quality;library;spectral;
StartupNotify=true
